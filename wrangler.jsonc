{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dzonyx",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dzonyx-db",
      "database_id": "acb5b5d7-ff31-4ea2-b670-82bb994350da"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "dzonyx-comics"
    }
  ],
  "observability": {
    "enabled": true
  }
}
